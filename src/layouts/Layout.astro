---
import Footer from "../components/Footer.astro";
import { TopMenu } from "../components/ui/TopMenu";
import { ScrollToTop } from "../components/ui/ScrollToTop";
import { siteConfig, absoluteUrl, whatsappUrl, GOOGLE_SITE_VERIFICATION } from "../config/site";
import { services } from "../constants/services";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  /** Imagen crítica (LCP) a precargar. Solo pasarla en la página que la usa above the fold. */
  preloadImage?: string;
  noindex?: boolean;
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.description,
  image = siteConfig.defaultImage,
  type = "website",
  preloadImage,
  noindex = false,
} = Astro.props;

const canonicalURL = absoluteUrl(Astro.url.pathname);
const imageURL = absoluteUrl(image);
const { address, geo, contact, social } = siteConfig;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "AutomotiveBusiness",
  "@id": `${siteConfig.url}/#business`,
  name: siteConfig.name,
  url: siteConfig.url,
  logo: absoluteUrl(siteConfig.logo),
  image: [absoluteUrl(siteConfig.logo), absoluteUrl(siteConfig.defaultImage)],
  description: siteConfig.description,
  slogan: siteConfig.slogan,
  foundingDate: siteConfig.foundingYear,
  telephone: `+${contact.whatsapp}`,
  email: contact.email,
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: address.street,
    addressLocality: address.city,
    addressRegion: address.region,
    postalCode: address.postalCode,
    addressCountry: address.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: geo.latitude,
    longitude: geo.longitude,
  },
  hasMap: address.mapsUrl,
  areaServed: siteConfig.areaServed.map((name) => ({ "@type": "City", name })),
  openingHoursSpecification: siteConfig.openingHours.map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  contactPoint: [
    {
      "@type": "ContactPoint",
      telephone: `+${contact.whatsapp}`,
      contactType: "customer service",
      contactOption: "TollFree",
      areaServed: "CO",
      availableLanguage: "Spanish",
    },
    {
      "@type": "ContactPoint",
      telephone: `+57${contact.landline}`,
      contactType: "customer service",
      areaServed: "CO",
      availableLanguage: "Spanish",
    },
  ],
  sameAs: [social.facebook, social.instagram, whatsappUrl],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios automotrices",
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: s.name,
        description: s.content,
        provider: { "@id": `${siteConfig.url}/#business` },
        areaServed: siteConfig.areaServed.map((name) => ({ "@type": "City", name })),
      },
    })),
  },
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteConfig.url}/#website`,
  url: siteConfig.url,
  name: siteConfig.name,
  inLanguage: "es-CO",
  publisher: { "@id": `${siteConfig.url}/#business` },
};
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo/logox500.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"}
    />
    <link rel="canonical" href={canonicalURL} />
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Geo -->
    <meta name="geo.region" content={address.regionCode} />
    <meta name="geo.placename" content={`${address.city}, ${address.region}`} />
    <meta name="geo.position" content={`${geo.latitude};${geo.longitude}`} />
    <meta name="ICBM" content={`${geo.latitude}, ${geo.longitude}`} />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    {preloadImage && <link rel="preload" href={preloadImage} as="image" />}

    <!-- Shoelace theme (requerido por sl-carousel / sl-drawer / sl-dialog) -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/light.css"
    />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
    <slot name="head" />
  </head>

  <body class="antialiased">
    <TopMenu client:load />
    <main>
      <ScrollToTop client:load />
      <slot />
    </main>
    <Footer />
  </body>
</html>
