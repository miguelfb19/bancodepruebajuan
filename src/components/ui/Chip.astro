---
/** Etiqueta pequeña (tema, insignia). tone: light sobre fondos claros, dark sobre navy. */
import Icon from "./Icon.astro";
import type { IconName } from "../../assets/icons";

interface Props {
  icon?: IconName;
  tone?: "light" | "dark";
  class?: string;
}
const { icon, tone = "light", class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold tracking-wide",
    tone === "light" ? "metal-brushed text-primary" : "border border-white/30 bg-white/10 text-white backdrop-blur-sm",
    className,
  ]}
>
  {icon && <Icon name={icon} size={14} />}
  <slot />
</span>
