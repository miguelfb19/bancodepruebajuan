---
import Icon from "./Icon.astro";
---

<button
  id="scroll-to-top"
  type="button"
  aria-label="Volver arriba"
  class="scroll-top fixed bottom-10 right-6 md:right-10 z-50 grid place-items-center w-14 h-14 rounded-full text-white"
  data-hidden
>
  <Icon name="arrowUp" size={24} />
</button>

<style>
  .scroll-top {
    background-image: linear-gradient(180deg, var(--color-primary-700), var(--color-primary) 55%, var(--color-primary-900));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      inset 0 -1px 0 rgb(0 0 0 / 0.4),
      0 0 0 1px rgb(255 255 255 / 0.12),
      var(--shadow-2);
    cursor: pointer;
    transition:
      opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
      translate 200ms cubic-bezier(0.23, 1, 0.32, 1),
      filter var(--dur-micro) var(--ease-firm);
  }
  .scroll-top[data-hidden] {
    opacity: 0;
    translate: 0 0.75rem;
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .scroll-top:hover {
      filter: brightness(1.12);
    }
  }
  .scroll-top:active {
    translate: 0 1px;
  }
</style>

<script>
  const btn = document.getElementById("scroll-to-top");
  if (btn) {
    let ticking = false;
    const update = () => {
      btn.toggleAttribute("data-hidden", window.scrollY <= window.innerHeight);
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
    update();
    btn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
  }
</script>
