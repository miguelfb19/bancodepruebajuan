---
/**
 * Animación de marca: el carro del logo (vista frontal) sobre un elevador de dos columnas.
 * Trazos con relleno translúcido para dar volumen. El trazo se dibuja al entrar en
 * pantalla (scroll-driven) y el elevador sube y baja; un láser mide bajo el carro.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 320 220"
  class:list={["car-lift", className]}
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <!-- Columnas y base -->
  <g class="car-lift__posts">
    <path d="M12 204 H308" pathLength="1" />
    <rect x="26" y="26" width="16" height="178" rx="3" pathLength="1" class="car-lift__fill" />
    <rect x="278" y="26" width="16" height="178" rx="3" pathLength="1" class="car-lift__fill" />
    <!-- escala de medición -->
    <path d="M42 56 h8 M42 86 h8 M42 116 h8 M42 146 h8 M42 176 h8" pathLength="1" class="car-lift__ticks" />
    <path d="M278 56 h-8 M278 86 h-8 M278 116 h-8 M278 146 h-8 M278 176 h-8" pathLength="1" class="car-lift__ticks" />
  </g>

  <!-- Plataforma + carro -->
  <g class="car-lift__car">
    <!-- brazos del elevador -->
    <path d="M42 160 H90 M230 160 H278" pathLength="1" />
    <rect x="84" y="156" width="152" height="10" rx="4" pathLength="1" class="car-lift__fill" />

    <!-- ruedas -->
    <rect x="86" y="128" width="26" height="30" rx="6" pathLength="1" class="car-lift__tire" />
    <rect x="208" y="128" width="26" height="30" rx="6" pathLength="1" class="car-lift__tire" />

    <!-- carrocería -->
    <path
      d="M78 150 V116 C78 108 82 104 90 102 L104 72 C108 64 116 60 126 60 H194 C204 60 212 64 216 72 L230 102 C238 104 242 108 242 116 V150 C242 154 239 156 235 156 H85 C81 156 78 154 78 150 Z"
      pathLength="1"
      class="car-lift__body"
    />
    <!-- parabrisas -->
    <path d="M110 100 L120 74 C122 70 126 68 130 68 H190 C194 68 198 70 200 74 L210 100 Z" pathLength="1" class="car-lift__glass" />
    <!-- capó -->
    <path d="M96 112 C118 106 202 106 224 112" pathLength="1" />
    <!-- espejos -->
    <path d="M78 104 H66 C62 104 60 106 60 110 V114 H78" pathLength="1" />
    <path d="M242 104 H254 C258 104 260 106 260 110 V114 H242" pathLength="1" />
    <!-- faros -->
    <path d="M88 124 H118 C122 124 124 126 124 130 V134 C124 138 122 140 118 140 H88 Z" pathLength="1" class="car-lift__lamp" />
    <path d="M232 124 H202 C198 124 196 126 196 130 V134 C196 138 198 140 202 140 H232 Z" pathLength="1" class="car-lift__lamp" />
    <!-- parrilla y parachoques -->
    <path d="M134 128 H186 M134 136 H186" pathLength="1" class="car-lift__ticks" />
    <path d="M90 148 H230" pathLength="1" />
    <!-- placa -->
    <rect x="144" y="142" width="32" height="8" rx="2" pathLength="1" class="car-lift__accent" />
  </g>

  <!-- Láser de medición -->
  <path d="M46 184 H274" pathLength="1" class="car-lift__laser" stroke-width="2" />
</svg>

<style>
  .car-lift {
    overflow: visible;
  }
  .car-lift__fill {
    fill: currentColor;
    fill-opacity: 0.1;
  }
  .car-lift__body {
    fill: currentColor;
    fill-opacity: 0.12;
  }
  .car-lift__glass {
    fill: currentColor;
    fill-opacity: 0.28;
  }
  .car-lift__tire {
    fill: currentColor;
    fill-opacity: 0.35;
  }
  .car-lift__lamp {
    fill: #fff;
    fill-opacity: 0.85;
    stroke-width: 2;
  }
  .car-lift__accent {
    stroke: var(--color-secondary);
    fill: var(--color-secondary);
    fill-opacity: 0.6;
  }
  .car-lift__laser {
    stroke: var(--color-secondary);
    transform-origin: 50% 50%;
    transform-box: fill-box;
  }
  .car-lift__ticks {
    stroke-width: 2;
    opacity: 0.55;
  }

  /* Trazo que se dibuja al entrar (progreso ligado al scroll; sin soporte queda dibujado) */
  .car-lift path,
  .car-lift rect {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: 0% 100%)) {
      .car-lift path,
      .car-lift rect {
        animation: draw auto linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 90%;
      }
    }
    .car-lift__car {
      animation: lift 6s cubic-bezier(0.77, 0, 0.175, 1) infinite;
    }
    .car-lift__laser {
      animation: laser 6s cubic-bezier(0.77, 0, 0.175, 1) infinite;
    }
    .car-lift__lamp {
      animation: lamp 6s cubic-bezier(0.77, 0, 0.175, 1) infinite;
    }
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes lift {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -16px;
    }
  }
  @keyframes laser {
    0%,
    100% {
      opacity: 0.25;
      scale: 0.92 1;
    }
    50% {
      opacity: 1;
      scale: 1 1;
    }
  }
  @keyframes lamp {
    0%,
    100% {
      fill-opacity: 0.5;
    }
    50% {
      fill-opacity: 1;
    }
  }
</style>
