---
/**
 * Modal accesible basado en <dialog> nativo. Sin JS de terceros.
 * Se abre con cualquier elemento que tenga data-open-dialog="<id>".
 * Cierra con Escape, clic en el backdrop o elementos con data-close-dialog.
 */
import Icon from "./Icon.astro";

interface Props {
  id: string;
  /** "center" = modal clásico; "side" = panel lateral tipo drawer. */
  variant?: "center" | "side";
  labelledBy?: string;
  class?: string;
}

const { id, variant = "center", labelledBy, class: className } = Astro.props;
---

<dialog id={id} class:list={["app-dialog", `app-dialog--${variant}`, className]} aria-labelledby={labelledBy}>
  <div class="app-dialog__panel">
    <button
      type="button"
      class="app-dialog__close"
      data-close-dialog
      aria-label="Cerrar"
    >
      <Icon name="closeX" size={22} />
    </button>
    <div class="app-dialog__content">
      <slot />
    </div>
  </div>
</dialog>

<script>
  const initDialogs = () => {
    document.querySelectorAll<HTMLElement>("[data-open-dialog]").forEach((trigger) => {
      if (trigger.dataset.bound) return;
      trigger.dataset.bound = "true";
      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        const dialog = document.getElementById(trigger.dataset.openDialog!) as HTMLDialogElement | null;
        dialog?.showModal();
      });
    });

    document.querySelectorAll<HTMLDialogElement>("dialog.app-dialog").forEach((dialog) => {
      if (dialog.dataset.bound) return;
      dialog.dataset.bound = "true";
      dialog.querySelectorAll("[data-close-dialog]").forEach((btn) =>
        btn.addEventListener("click", () => dialog.close()),
      );
      // Clic en el backdrop (fuera del panel) cierra.
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    });
  };
  initDialogs();
  document.addEventListener("astro:page-load", initDialogs);
</script>
