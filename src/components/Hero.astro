---
import { Image } from "astro:assets";
import Button from "./ui/Button.astro";
import { siteConfig } from "../config/site";
import portada from "../assets/images/portada/portada.avif";
---

<header id="header" class="relative h-[calc(100dvh-100px)] min-h-[34rem] overflow-hidden">
  <Image
    src={portada}
    alt="Técnico de Banco de Prueba Juan revisando el chasis de un vehículo elevado en el taller de Pereira"
    width={1920}
    widths={[640, 960, 1280, 1920, 2880]}
    sizes="100vw"
    format="avif"
    quality={60}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 w-full h-full object-cover object-[68%_center] md:object-center"
  />

  <div class="absolute inset-0 bg-gradient-to-r from-primary/80 via-primary/50 to-primary/10 md:to-transparent"></div>

  <div class="relative z-10 h-full flex flex-col justify-center gap-8 p-8 md:p-16 max-w-3xl">
    <div>
      <p class="uppercase tracking-[0.3em] text-xs md:text-sm text-white/80 mb-4">Enderezado y soldadura automotriz · Pereira</p>
      <h1 class="text-4xl md:text-6xl font-bold text-white text-shadow mb-6 leading-tight">
        Especialistas en Enderezado de Chasis en Pereira
      </h1>
      <p class="md:text-lg text-white/90 text-shadow max-w-xl">
        {siteConfig.yearsOfExperience} años de experiencia garantizando la seguridad y alineación perfecta de tu vehículo. Diagnóstico técnico confiable y garantía en cada trabajo.
      </p>
    </div>
    <div class="flex max-sm:flex-col gap-4 w-full sm:max-w-md">
      <Button href="/contact" class="w-full !shadow-white !shadow-xl">Contáctanos</Button>
      <Button href="/servicios" variant="btn-3" class="w-full !shadow-white !shadow-xl">Nuestros servicios</Button>
    </div>
  </div>
</header>
