---
import { Image } from "astro:assets";
import Button from "./ui/Button.astro";
import Chip from "./ui/Chip.astro";
import OpenStatus from "./ui/OpenStatus.astro";
import { siteConfig } from "../config/site";
import portada from "../assets/images/portada/portada.avif";
---

<header id="header" class="relative h-[calc(100dvh-100px)] min-h-[36rem] overflow-hidden">
  <Image
    src={portada}
    alt="Técnico de Banco de Prueba Juan revisando el chasis de un vehículo elevado en el taller de Pereira"
    width={1920}
    widths={[640, 960, 1280, 1920, 2880]}
    sizes="100vw"
    format="avif"
    quality={60}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 w-full h-full object-cover object-[68%_center] md:object-center"
  />

  <div class="absolute inset-0 bg-gradient-to-r from-primary/85 via-primary/50 to-primary/10 md:to-transparent"></div>

  <!-- Línea de escaneo: "medimos" (una sola pasada) -->
  <div class="scan-line" aria-hidden="true"></div>

  <!-- Titular en la zona navy superior derecha (como en la portada original) -->
  <p
    aria-hidden="true"
    class="hidden md:flex absolute top-[7%] right-[6%] lg:right-[8%] z-10 flex-col items-end text-right text-white text-shadow leading-none select-none"
  >
    <span class="font-display text-4xl lg:text-5xl font-semibold tracking-wide">Enderezado y soldadura</span>
    <span class="font-display text-6xl lg:text-8xl font-bold tracking-tight text-steel">AUTOMOTRIZ</span>
  </p>

  <div class="relative z-10 h-full flex flex-col justify-center gap-8 p-8 md:p-16 max-w-3xl">
    <div class="flex flex-col gap-5">
      <OpenStatus class="self-start" />
      <h1 class="font-display text-5xl md:text-7xl font-bold text-white text-shadow leading-[0.95]">
        Especialistas en Enderezado de Chasis en Pereira
      </h1>
      <p class="md:text-lg text-white/90 text-shadow max-w-xl">
        {siteConfig.yearsOfExperience} años de experiencia garantizando la seguridad y alineación perfecta de tu vehículo. Diagnóstico técnico confiable y garantía en cada trabajo.
      </p>
    </div>

    <div class="flex max-sm:flex-col gap-4 w-full sm:max-w-md">
      <Button href="/contact" class="w-full !shadow-white/60 !shadow-xl">Contáctanos</Button>
      <Button href="/servicios" variant="btn-3" class="w-full !shadow-white/60 !shadow-xl">Nuestros servicios</Button>
    </div>

    <ul class="flex flex-wrap gap-2" aria-label="Razones para confiar">
      <li><Chip tone="dark" icon="check">{siteConfig.yearsOfExperience} años de experiencia</Chip></li>
      <li><Chip tone="dark" icon="shakeHands">Garantía en cada trabajo</Chip></li>
      <li><Chip tone="dark" icon="diagnostic">Diagnóstico en 10–30 min</Chip></li>
    </ul>
  </div>
</header>
