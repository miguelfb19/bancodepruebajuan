---
import { contactInfo, type ContactItem } from "../../constants/contact-info";
import Icon from "../ui/Icon.astro";

const columns: ContactItem[][] = [contactInfo.slice(0, 3), contactInfo.slice(3)];
---

<div class="flex flex-col text-center mt-10 gap-10 pb-20">
  <div>
    <h2 class="text-4xl font-bold text-primary">Ponte en contacto</h2>
    <p class="text-tertiary text-lg">Estamos aquí para ayudarte con tu vehículo.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 px-4 md:justify-items-center">
    {columns.map((column) => (
      <div class="space-y-6 text-left">
        {column.map((info) => (
          <a
            href={info.link}
            target={info.external ? "_blank" : undefined}
            rel={info.external ? "noopener noreferrer" : undefined}
            class="flex items-center gap-4 md:min-w-[22rem] rounded-2xl shadow-lg p-4 hover:scale-[101%] hover:shadow-xl transition-transform duration-200"
          >
            <div class="metal-badge w-12 h-12 rounded-full flex items-center justify-center text-primary shadow-lg">
              <Icon name={info.icon} size={25} />
            </div>
            <div>
              <h3 class="font-semibold text-primary">{info.title}</h3>
              <p class="text-tertiary whitespace-pre-line">{info.description}</p>
            </div>
          </a>
        ))}
      </div>
    ))}
  </div>
</div>
