---
import { siteConfig } from "../../config/site";
---

<div class="bg-primary py-20">
  <h2 class="text-3xl font-bold text-white text-center mb-10">
    ¿Dónde estamos ubicados?
  </h2>
  <iframe
    title={`Ubicación de ${siteConfig.name} en Google Maps`}
    class="rounded-lg shadow-lg m-auto"
    src={siteConfig.address.mapsEmbedUrl}
    width="90%"
    height="500"
    style="border:0;"
    allowfullscreen=""
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"></iframe>
</div>
