---
import Button from "./ui/Button.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import { whatsappUrl } from "../config/site";
---

<section id="cta" class="cv-auto scroll-reveal flex flex-col gap-12 py-20 px-10">
  <SectionHeading title="Llama y obtén asesoría inmediata" />
  <div class="flex flex-wrap gap-4 justify-center items-center">
    <Button href={whatsappUrl} external size="lg" icon="whatsapp" iconClass="w-7 h-7">Contáctanos ahora</Button>
    <Button href="/diagnostico" size="lg" variant="btn-2">¿No sabes qué necesitas? Haz el pre-diagnóstico</Button>
  </div>
</section>
