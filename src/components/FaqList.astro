---
/** Acordeón de FAQ con <details> nativo + schema FAQPage generado de los mismos datos. */
import type { FaqItem } from "../constants/faq";
import Icon from "./ui/Icon.astro";

interface Props {
  items: FaqItem[];
  schema?: boolean;
}

const { items, schema = true } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<div class="flex flex-col gap-3">
  {items.map((f) => (
    <details class="faq-item group metal-brushed rounded-2xl">
      <summary class="cursor-pointer flex items-center gap-4 p-5 text-lg font-semibold text-primary">
        <span aria-hidden="true" class="metal-badge shrink-0 w-8 h-8 rounded-full grid place-items-center text-secondary-strong transition-transform duration-200 group-open:rotate-45">
          <Icon name="closeX" size={14} class="rotate-45" />
        </span>
        <span>{f.question}</span>
      </summary>
      <p class="text-tertiary px-5 pb-5 pl-[4.25rem]">{f.answer}</p>
    </details>
  ))}
</div>

{schema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
