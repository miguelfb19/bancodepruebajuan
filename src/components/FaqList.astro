---
/** Lista de FAQ con <details> nativo + schema FAQPage generado de los mismos datos. */
import type { FaqItem } from "../constants/faq";

interface Props {
  items: FaqItem[];
  /** Si es false no emite el JSON-LD (para evitar dos FAQPage en una misma página). */
  schema?: boolean;
}

const { items, schema = true } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<div class="flex flex-col gap-3">
  {items.map((f) => (
    <details class="faq-item group bg-white rounded-2xl shadow-lg p-5">
      <summary class="cursor-pointer list-none flex justify-between items-center gap-4 text-lg font-semibold text-primary">
        <span>{f.question}</span>
        <span aria-hidden="true" class="shrink-0 text-secondary text-2xl leading-none transition-transform group-open:rotate-45">+</span>
      </summary>
      <p class="text-tertiary mt-3">{f.answer}</p>
    </details>
  ))}
</div>

{schema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
