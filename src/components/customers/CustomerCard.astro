---
import Icon from "../ui/Icon.astro";

const { customer } = Astro.props;
---

<figure class="metal-dark rivets rounded-2xl flex flex-col gap-4 p-6 pt-8 text-center">
  <span aria-hidden="true" class="font-display text-6xl leading-none text-secondary -mb-6">“</span>
  <blockquote class="text-white/90 italic flex-1">{customer.comment}</blockquote>
  <figcaption class="flex flex-col items-center gap-1">
    <span class="w-10 h-10 rounded-full metal-badge grid place-items-center font-display font-bold text-primary">{customer.name.charAt(0)}</span>
    <span class="font-semibold text-white">{customer.name}</span>
    <span class="text-yellow-400 flex justify-center items-center" aria-label="5 de 5 estrellas" role="img">
      {Array.from({ length: 5 }).map(() => <Icon name="star" size={16} />)}
    </span>
  </figcaption>
</figure>
