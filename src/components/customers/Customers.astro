---
import Icon from "../ui/Icon.astro";
import { customersComments } from "../../constants/customers";
import CustomerCard from "./CustomerCard.astro";
import { siteConfig } from "../../config/site";
---

<section id="customers" class="scroll-reveal flex flex-col gap-10 py-20 px-10">
  <h2
    class="text-5xl md:text-6xl bg-[linear-gradient(to_right,var(--tw-gradient-from),var(--tw-gradient-from)_40%,var(--tw-gradient-to)_80%,var(--tw-gradient-to)_100%)] from-primary to-secondary text-transparent bg-clip-text text-center font-bold"
  >
    Lo que dicen nuestros clientes
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {customersComments.map((item) => <CustomerCard customer={item} />)}
  </div>

  <a
    href={siteConfig.social.googleReviews}
    target="_blank"
    rel="noopener noreferrer"
    class="text-sm text-primary underline text-center flex justify-center gap-2"
  >Ver más opiniones <Icon name="linkOut" /></a>
</section>
