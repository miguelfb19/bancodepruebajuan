---
import Icon from "../ui/Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { customersComments } from "../../constants/customers";
import CustomerCard from "./CustomerCard.astro";
import { siteConfig } from "../../config/site";
---

<section id="customers" class="cv-auto scroll-reveal flex flex-col gap-10 py-20 px-10">
  <SectionHeading title="Lo que dicen nuestros clientes" />

  <div class="stagger grid grid-cols-1 md:grid-cols-3 gap-6">
    {customersComments.map((item) => <CustomerCard customer={item} />)}
  </div>

  <a
    href={siteConfig.social.googleReviews}
    target="_blank"
    rel="noopener noreferrer"
    class="text-sm text-primary underline text-center flex justify-center items-center gap-2 hover:text-secondary-strong"
  >Ver más opiniones <Icon name="linkOut" /></a>
</section>
