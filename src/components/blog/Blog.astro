---
import { articles } from "../../constants/articles";
import BlogCard from "./BlogCard.astro";
---

<section id="blog" class="scroll-reveal bg-primary p-10 md:p-20 flex flex-col gap-5 md:gap-20">
  <h2 class="text-white text-5xl md:text-6xl text-center font-bold text-shadow">Temas de interés</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
    {articles.map((article) => <BlogCard article={article} />)}
  </div>
</section>
