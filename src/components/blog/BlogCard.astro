---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Button from "../ui/Button.astro";

interface Props {
  post: CollectionEntry<"blog">;
  /** Variante oscura para la sección de la home (fondo primary). */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const href = `/blog/${post.id}`;
const { title, description, image, imageAlt } = post.data;
---

<article class="metal-card rounded-2xl text-primary flex flex-col overflow-hidden shadow-lg hover:scale-[102%] hover:shadow-xl transition-all duration-300">
  <a href={href} aria-label={`Leer: ${title}`}>
    <Image
      src={image}
      alt={imageAlt}
      width={800}
      widths={[480, 800]}
      sizes="(min-width: 768px) 50vw, 100vw"
      format="avif"
      quality={60}
      loading={eager ? "eager" : "lazy"}
      class="w-full h-48 object-cover"
    />
  </a>
  <div class="flex flex-col gap-4 p-6 md:p-8 text-center flex-1 justify-between">
    <h3 class="font-bold text-xl"><a href={href}>{title}</a></h3>
    <p class="text-tertiary">{description}</p>
    <Button href={href} class="self-center">Leer más</Button>
  </div>
</article>
