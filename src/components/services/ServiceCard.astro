---
import { Image } from "astro:assets";
import type { Service } from "../../interfaces/Service";
import Button from "../ui/Button.astro";

interface Props {
  service: Service;
  /** Carga eager para tarjetas above the fold (p. ej. en /servicios). */
  eager?: boolean;
}

const { service, eager = false } = Astro.props;
const { slug, name, text, picture } = service;
const href = `/servicios/${slug}`;
---

<article
  class="flex flex-col justify-between pb-5 gap-5 metal-card rounded-2xl text-primary shadow-lg shadow-tertiary hover:scale-[102%] hover:shadow-xl transition-all duration-300"
>
  <a href={href} class="flex flex-col gap-3 overflow-hidden" aria-label={`Ver servicio de ${name}`}>
    <Image
      src={picture}
      alt={`Servicio de ${name} - Banco de Prueba Juan`}
      width={900}
      widths={[400, 640, 900]}
      sizes="(min-width: 768px) 33vw, 100vw"
      format="avif"
      quality={60}
      loading={eager ? "eager" : "lazy"}
      class="w-full h-48 object-cover rounded-t-xl"
    />
    <h3 class="mx-3 text-center text-2xl font-semibold text-primary">{name}</h3>
    <p class="mx-3 text-center whitespace-pre-line text-sm text-primary">{text}</p>
  </a>
  <Button href={href} class="mx-3">Ver servicio</Button>
</article>
