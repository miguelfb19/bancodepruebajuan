---
import { services } from "../../constants/services";
import ServiceCard from "./ServiceCard.astro";
import Button from "../ui/Button.astro";
---

<section id="services" class="flex flex-col gap-16 p-10 md:p-16">
  <h2 class="heading-gradient text-5xl md:text-6xl text-center font-bold">Nuestros servicios</h2>
  <div id="services-cards" class="scroll-reveal grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch">
    {services.map((service) => <ServiceCard service={service} />)}
  </div>
  <Button href="/servicios" variant="btn-2" class="self-center">Ver todos los servicios</Button>
</section>
