---
import { services } from "../../constants/services";
import ServiceCard from "./ServiceCard.astro";
import Button from "../ui/Button.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section id="services" class="cv-auto flex flex-col gap-14 p-10 md:p-16">
  <SectionHeading title="Nuestros servicios" />
  <div id="services-cards" class="stagger grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
    {services.map((service) => <ServiceCard service={service} />)}
  </div>
  <Button href="/servicios" variant="btn-2" class="self-center">Ver todos los servicios</Button>
</section>
