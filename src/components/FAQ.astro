---
import { faqs } from "../constants/faq";
import FaqList from "./FaqList.astro";
import SectionHeading from "./ui/SectionHeading.astro";
---

<section id="faq" aria-labelledby="faq-title" class="cv-auto py-20 px-10 bg-gradient-to-br from-steel-50 to-white">
  <div class="max-w-4xl mx-auto flex flex-col gap-12">
    <SectionHeading id="faq-title" title="Preguntas frecuentes" />
    <FaqList items={faqs} />
  </div>
</section>
