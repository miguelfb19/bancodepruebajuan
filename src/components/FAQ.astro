---
import { faqs } from "../constants/faq";
import FaqList from "./FaqList.astro";
---

<section id="faq" class="py-20 px-10 bg-gradient-to-br from-slate-100 to-white">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-4xl font-bold text-center text-primary mb-16">Preguntas frecuentes</h2>
    <FaqList items={faqs} />
  </div>
</section>
