---
import Badge from "./ui/Badge.astro";
import Stat from "./ui/Stat.astro";
import { siteConfig } from "../config/site";

const pillars = [
  { icon: "shakeHands", text: "Transparencia en servicio y precios" },
  { icon: "diagnostic", text: "Diagnóstico técnico, claro y confiable" },
  { icon: "check", text: "Si lo revisamos, lo garantizamos" },
] as const;
---

<section id="experience" class="cv-auto scroll-reveal metal-dark relative overflow-hidden flex flex-col gap-14 p-10 md:p-16">
  <!-- Veta roja de marca -->
  <div aria-hidden="true" class="absolute -right-24 -top-24 w-96 h-96 rounded-full bg-secondary/25 blur-3xl"></div>

  <Stat value={siteConfig.yearsOfExperience} label="años de experiencia" />

  <ul class="stagger grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto w-full">
    {pillars.map((p) => (
      <li class="metal-brushed rivets rounded-2xl p-6 flex flex-col items-center gap-4 text-center text-primary">
        <Badge icon={p.icon} size={40} />
        <p class="font-display text-2xl font-semibold leading-tight">{p.text}</p>
      </li>
    ))}
  </ul>
</section>
