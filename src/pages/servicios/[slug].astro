---
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import FaqList from "../../components/FaqList.astro";
import { services } from "../../constants/services";
import { siteConfig, absoluteUrl, whatsappUrl } from "../../config/site";

export const getStaticPaths = () => services.map((service) => ({ params: { slug: service.slug }, props: { service } }));

const { service } = Astro.props;
const { name, content, picture, seo, whenNeeded, process, scope, duration, faqs } = service;
const url = absoluteUrl(`/servicios/${service.slug}`);
const og = await getImage({ src: picture, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 80 });
const related = services.filter((s) => s.slug !== service.slug);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${url}#service`,
  name,
  serviceType: seo.serviceType,
  description: seo.description,
  url,
  image: absoluteUrl(og.src),
  provider: { "@id": `${siteConfig.url}/#business` },
  areaServed: siteConfig.areaServed.map((n) => ({ "@type": "City", name: n })),
  availableChannel: {
    "@type": "ServiceChannel",
    serviceUrl: whatsappUrl,
    servicePhone: `+${siteConfig.contact.whatsapp}`,
    availableLanguage: "es",
  },
};

const whatsappText = encodeURIComponent(`Hola, quiero una cotización de ${name.toLowerCase()}.`);
---

<Layout title={seo.title} description={seo.description} image={og.src}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- Cabecera -->
  <div class="relative w-full h-72 md:h-[28rem] flex items-end overflow-hidden">
    <Image
      src={picture}
      alt={`${name} en el taller de ${siteConfig.name}, Pereira`}
      width={1600}
      widths={[640, 1024, 1600, 2048]}
      sizes="100vw"
      format="avif"
      quality={55}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-primary/90 via-primary/40 to-black/20"></div>
    <div class="relative z-10 p-10 md:p-16 text-white max-w-4xl">
      <p class="uppercase tracking-widest text-sm text-white/80 mb-2">Servicio en Pereira</p>
      <h1 class="text-4xl md:text-6xl font-bold text-shadow">{name}</h1>
    </div>
  </div>
  <Breadcrumbs items={[{ name: "Servicios", url: "/servicios" }, { name, url: `/servicios/${service.slug}` }]} />

  <article class="px-10 md:px-16 pb-20 flex flex-col gap-16 max-w-6xl mx-auto">
    <section class="grid md:grid-cols-[2fr_1fr] gap-10 items-start">
      <p class="text-lg leading-relaxed text-tertiary">{content}</p>
      <aside class="metal-card rounded-2xl shadow-lg p-6 flex flex-col gap-4">
        <p class="font-semibold text-primary text-xl">¿Tu carro presenta estos síntomas?</p>
        <p class="text-sm text-tertiary">Escríbenos con la marca, el modelo y qué le pasa. La cotización y el diagnóstico toman entre 10 y 30 minutos.</p>
        <Button href={`${whatsappUrl}?text=${whatsappText}`} external icon="whatsapp" iconClass="w-6 h-6">Cotizar por WhatsApp</Button>
        <p class="text-xs text-tertiary text-center">{siteConfig.address.street}, {siteConfig.address.city}</p>
      </aside>
    </section>

    <section>
      <h2 class="text-3xl font-bold text-primary mb-6">¿Cuándo necesitas {name.toLowerCase()}?</h2>
      <ul class="grid md:grid-cols-2 gap-4">
        {whenNeeded.map((item) => (
          <li class="flex gap-3 items-start rounded-xl bg-white shadow p-4">
            <Icon name="check" size={28} class="shrink-0 text-secondary" />
            <span class="text-tertiary">{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-3xl font-bold text-primary mb-6">Cómo lo hacemos</h2>
      <ol class="flex flex-col gap-4">
        {process.map((step, i) => (
          <li class="flex gap-4 items-start">
            <span class="shrink-0 w-10 h-10 rounded-full bg-primary text-white font-bold grid place-items-center">{i + 1}</span>
            <p class="text-tertiary pt-2">{step}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-tertiary"><strong class="text-primary">Tiempo estimado:</strong> {duration}</p>
    </section>

    <section class="grid md:grid-cols-2 gap-6">
      <div class="rounded-2xl p-6 bg-primary text-white">
        <h2 class="text-2xl font-bold mb-4">Qué incluye</h2>
        <ul class="flex flex-col gap-2 list-disc pl-5">{scope.includes.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div class="rounded-2xl p-6 border-2 border-secondary text-primary">
        <h2 class="text-2xl font-bold mb-4">Qué no incluye</h2>
        <ul class="flex flex-col gap-2 list-disc pl-5">{scope.excludes.map((i) => <li>{i}</li>)}</ul>
      </div>
    </section>

    <section>
      <h2 class="text-3xl font-bold text-primary mb-6">Preguntas frecuentes sobre {name.toLowerCase()}</h2>
      <FaqList items={faqs} />
    </section>

    <section>
      <h2 class="text-2xl font-bold text-primary mb-4">Otros servicios</h2>
      <div class="flex flex-wrap gap-4">
        {related.map((r) => <Button href={`/servicios/${r.slug}`} variant="btn-2">{r.name}</Button>)}
        <Button href="/blog" variant="btn-2">Blog</Button>
      </div>
    </section>
  </article>
</Layout>
