---
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Button from "../../components/ui/Button.astro";
import Card from "../../components/ui/Card.astro";
import Chip from "../../components/ui/Chip.astro";
import Icon from "../../components/ui/Icon.astro";
import { siteConfig, absoluteUrl, whatsappUrl } from "../../config/site";
import { readingTime, formatDate } from "../../lib/reading-time";
import { serviceForTags } from "../../constants/service-tags";
import { getService } from "../../constants/services";

export const getStaticPaths = async () => {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, image, imageAlt, source, sourceName, tags } = post.data;
const url = absoluteUrl(`/blog/${post.id}`);
const og = await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 80 });
const minutes = readingTime(post.body);
const toc = headings.filter((h) => h.depth === 2);
const related = getService(serviceForTags(tags));
const others = (await getCollection("blog")).filter((p) => p.id !== post.id).slice(0, 3);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${url}#article`,
  mainEntityOfPage: url,
  headline: title,
  description,
  image: absoluteUrl(og.src),
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: "es-CO",
  keywords: tags.join(", "),
  wordCount: post.body?.split(/\s+/).length,
  author: { "@type": "Organization", name: siteConfig.name, url: siteConfig.url },
  publisher: { "@id": `${siteConfig.url}/#business` },
  ...(source ? { citation: source } : {}),
};
---

<Layout title={`${title} | Blog Banco de Prueba Juan`} description={description} image={og.src} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="read-progress" aria-hidden="true"></div>

  <Breadcrumbs items={[{ name: "Blog", url: "/blog" }, { name: title, url: `/blog/${post.id}` }]} />

  <div class="px-10 md:px-16 pb-20 max-w-6xl mx-auto grid lg:grid-cols-[1fr_16rem] gap-12 items-start">
    <article class="flex flex-col gap-8 min-w-0">
      <header class="flex flex-col gap-4">
        <div class="flex flex-wrap gap-2">{tags.map((t) => <Chip>{t}</Chip>)}</div>
        <h1 class="font-display text-5xl md:text-6xl font-bold text-primary leading-[0.95]">{title}</h1>
        <p class="text-lg text-tertiary">{description}</p>
        <p class="text-sm text-tertiary">
          <time datetime={pubDate.toISOString()}>Publicado el {formatDate(pubDate)}</time>
          {updatedDate && <> · <time datetime={updatedDate.toISOString()}>Actualizado el {formatDate(updatedDate)}</time></>}
          · {minutes} min de lectura · Por {siteConfig.name}
        </p>
        <Image
          src={image}
          alt={imageAlt}
          width={1000}
          widths={[480, 800, 1000]}
          sizes="(min-width: 1024px) 48rem, 100vw"
          format="avif"
          quality={60}
          loading="eager"
          fetchpriority="high"
          class="w-full h-56 md:h-96 object-cover rounded-2xl shadow-lg"
        />
      </header>

      <div class="prose">
        <Content />
      </div>

      {source && (
        <p class="text-sm text-tertiary border-l-4 border-steel-300 pl-4">
          Fuente consultada:
          <a href={source} target="_blank" rel="noopener noreferrer nofollow" class="underline hover:text-primary">{sourceName ?? source}</a>
        </p>
      )}

      {related && (
        <Card finish="polished" rivets class="p-6 pt-8 flex flex-col md:flex-row md:items-center gap-5 justify-between">
          <div class="flex gap-4 items-start">
            <Icon name="diagnostic" size={36} class="shrink-0 text-secondary-strong" />
            <div>
              <p class="text-sm text-secondary-strong font-semibold">Aplica a tu caso</p>
              <p class="font-display font-semibold text-primary text-2xl leading-tight">{related.name}</p>
              <p class="text-sm text-tertiary mt-1">{related.text.split("\n\n")[0]}</p>
            </div>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <Button href={`/servicios/${related.slug}`} size="sm">Ver servicio</Button>
            <Button href={whatsappUrl} external size="sm" variant="btn-2" icon="whatsapp" iconClass="w-4 h-4">WhatsApp</Button>
          </div>
        </Card>
      )}

      {others.length > 0 && (
        <nav aria-label="Otros artículos" class="flex flex-col gap-3">
          <h2 class="font-display text-3xl font-bold text-primary">Sigue leyendo</h2>
          <ul class="flex flex-col gap-2">
            {others.map((p) => (
              <li><a href={`/blog/${p.id}`} class="underline text-primary hover:text-secondary-strong">{p.data.title}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </article>

    {toc.length > 1 && (
      <aside class="hidden lg:block sticky top-28">
        <nav aria-labelledby="toc-title" class="metal-brushed rounded-2xl p-5">
          <p id="toc-title" class="font-display text-xl text-primary mb-3">En este artículo</p>
          <ol class="flex flex-col gap-2 text-sm">
            {toc.map((h) => (
              <li><a href={`#${h.slug}`} class="toc-link text-primary hover:text-secondary-strong">{h.text}</a></li>
            ))}
          </ol>
        </nav>
      </aside>
    )}
  </div>
</Layout>

<style>
  .toc-link[aria-current="true"] {
    color: var(--color-secondary-strong);
    font-weight: 600;
  }
</style>

<script>
  // Progreso de lectura: fallback sin scroll-driven animations.
  if (!CSS.supports("animation-timeline", "scroll()")) {
    const bar = document.querySelector<HTMLElement>(".read-progress");
    if (bar) {
      const update = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.transform = `scaleX(${scrollable > 0 ? window.scrollY / scrollable : 0})`;
      };
      window.addEventListener("scroll", update, { passive: true });
      update();
    }
  }
  // Resaltar el apartado visible en el índice.
  const links = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
  if (links.length && "IntersectionObserver" in window) {
    const byId = new Map([...links].map((l) => [l.getAttribute("href")!.slice(1), l]));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((l) => l.removeAttribute("aria-current"));
            byId.get(e.target.id)?.setAttribute("aria-current", "true");
          }
        });
      },
      { rootMargin: "-20% 0px -70% 0px" },
    );
    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
</script>
