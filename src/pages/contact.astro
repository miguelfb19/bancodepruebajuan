---
import CardsContact from "../components/contact/CardsContact.astro";
import Layout from "../layouts/Layout.astro";
import Map from "../components/contact/Map.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { siteConfig } from "../config/site";
import PageHeader from "../components/PageHeader.astro";
import { getImage } from "astro:assets";
import establecimiento from "../assets/images/pages/establecimiento.avif";

const establecimientoOg = await getImage({ src: establecimiento, width: 1200, format: "jpg", quality: 80 });

const { address, contact } = siteConfig;
---

<Layout
  title="Contacto - Banco de Prueba Juan | Ubicación y Horarios en Pereira"
  description={`Contáctanos para enderezado de chasis en Pereira. Estamos en ${address.street}, ${address.neighborhood}. WhatsApp: ${contact.whatsappDisplay}. Atención de lunes a sábado.`}
  image={establecimientoOg.src}
>
  <section id="contact" class="min-h-screen">
    <PageHeader title="Contáctanos" />
    <Breadcrumbs items={[{ name: "Contacto", url: "/contact" }]} />

    <CardsContact />
    <Map />
  </section>
</Layout>
