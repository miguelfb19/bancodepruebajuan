---
import CardsContact from "../components/contact/CardsContact.astro";
import Layout from "../layouts/Layout.astro";
import Map from "../components/contact/Map.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { siteConfig } from "../config/site";

const { address, contact } = siteConfig;
---

<Layout
  title="Contacto - Banco de Prueba Juan | Ubicación y Horarios en Pereira"
  description={`Contáctanos para enderezado de chasis en Pereira. Estamos en ${address.street}, ${address.neighborhood}. WhatsApp: ${contact.whatsappDisplay}. Atención de lunes a sábado.`}
  image="/images/pages/establecimiento.avif"
>
  <section id="contact" class="min-h-screen">
    <div
      class="relative w-full h-64 md:h-96 bg-cover bg-top bg-no-repeat flex items-center justify-center bg-[url('/images/pages/establecimiento.avif')]"
    >
      <div class="absolute inset-0 bg-black/40"></div>
      <h1 class="relative z-10 text-4xl md:text-6xl font-bold text-white text-center text-shadow">
        Contáctanos
      </h1>
    </div>
    <Breadcrumbs items={[{ name: "Contacto", url: "/contact" }]} />

    <CardsContact />
    <Map />
  </section>
</Layout>
